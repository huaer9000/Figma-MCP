{
  "compilerOptions": {
    "target": "ES2017",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "lib": ["ES2020", "DOM"],
    "types": ["@figma/plugin-typings"]
  },
  "include": [
    "src/**/*.ts",
    "../shared/constants.ts",
    "../shared/errors.ts",
    "../shared/protocol.ts",
    "../shared/node-schema.ts"
  ]
}
